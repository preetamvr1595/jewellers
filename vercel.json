{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin/assets/:match*",
      "destination": "/admin/dist/assets/:match*"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/assets/:match*",
      "destination": "/frontend/assets/:match*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:file(.*\\..*)",
      "destination": "/frontend/:file"
    },
    {
      "source": "/:page",
      "destination": "/frontend/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
